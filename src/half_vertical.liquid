{%- assign stages = stages | default: data.stages | default: data -%}
{%- assign stage_today = today | default: data.today -%}
{%- assign stage_tomorrow = tomorrow | default: data.tomorrow -%}

{%- if stage_today == blank and stages -%}
  {%- assign stage_today = stages[0] -%}
{%- endif -%}
{%- if stage_tomorrow == blank and stages -%}
  {%- assign stage_tomorrow = stages[1] -%}
{%- endif -%}

{%- assign from = stage_today.departureCity.label | default: stage_today.from | default: "Start city" -%}
{%- assign to = stage_today.arrivalCity.label | default: stage_today.to | default: "Finish city" -%}
{%- assign hero_image = stage_today.departureCity.content.image | default: stage_today.fromImage | default: stage_today.arrivalCity.content.image | default: stage_today.toImage -%}

{%- assign next_from = stage_tomorrow.departureCity.label | default: stage_tomorrow.from | default: "Next start" -%}
{%- assign next_to = stage_tomorrow.arrivalCity.label | default: stage_tomorrow.to | default: "Next finish" -%}

{%- assign route_len = from.size | plus: to.size -%}
{%- assign next_route_len = next_from.size | plus: next_to.size -%}

{%- assign elevation_gain = stage_today.elevationGain | default: stage_today.elevation_gain | default: stage_today.positiveElevation -%}

{%- case stage_today.type -%}
  {%- when 'EQU' -%}{%- assign type_label = 'TEAM TIME TRIAL' -%}
  {%- when 'PAS' -%}{%- assign type_label = 'TIME TRIAL' -%}
  {%- when 'PLN' -%}{%- assign type_label = 'FLAT' -%}
  {%- when 'MMG' -%}{%- assign type_label = 'MED. MOUNTAIN' -%}
  {%- when 'HMG' -%}{%- assign type_label = 'MOUNTAIN' -%}
  {%- when 'VAA' -%}{%- assign type_label = 'HILLY' -%}
  {%- when 'PAA' -%}{%- assign type_label = 'HILLY' -%}
  {%- when 'VAL' -%}{%- assign type_label = 'HILLY' -%}
  {%- else -%}{%- assign type_label = stage_today.type | default: 'STAGE' -%}
{%- endcase -%}

{%- case stage_tomorrow.type -%}
  {%- when 'EQU' -%}{%- assign next_type_label = 'TEAM TIME TRIAL' -%}
  {%- when 'PAS' -%}{%- assign next_type_label = 'TIME TRIAL' -%}
  {%- when 'PLN' -%}{%- assign next_type_label = 'FLAT' -%}
  {%- when 'MMG' -%}{%- assign next_type_label = 'MED. MOUNTAIN' -%}
  {%- when 'HMG' -%}{%- assign next_type_label = 'MOUNTAIN' -%}
  {%- when 'VAA' -%}{%- assign next_type_label = 'HILLY' -%}
  {%- when 'PAA' -%}{%- assign next_type_label = 'HILLY' -%}
  {%- when 'VAL' -%}{%- assign next_type_label = 'HILLY' -%}
  {%- else -%}{%- assign next_type_label = stage_tomorrow.type | default: 'STAGE' -%}
{%- endcase -%}

{%- assign route_class = 'text--xlarge' -%}
{%- if route_len > 34 -%}
  {%- assign route_class = 'text--small' -%}
{%- elsif route_len > 24 -%}
  {%- assign route_class = 'text--base' -%}
{%- elsif route_len > 16 -%}
  {%- assign route_class = 'text--large' -%}
{%- endif -%}

{%- assign next_route_class = 'text--base' -%}
{%- if next_route_len > 30 -%}
  {%- assign next_route_class = 'text--small' -%}
{%- endif -%}

<style>
  .vta-portrait,
  .vta-portrait * { box-sizing: border-box; }

  .vta-portrait {
    --red: #e2001a;
    --paper: #f4f1e8;
    --ink: #111;
    --muted: #707070;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
    font-family: Inter, Arial, Helvetica, sans-serif;
  }

  .vta-card {
    width: 100%;
    height: 100%;
    border: 3px solid var(--ink);
    background: #fbfaf5;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto auto;
  }

  .vta-header {
    background: var(--ink);
    color: #fff;
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    min-width: 0;
  }

  .vta-logo-wrap { border-right: 2px solid #fff; }

  .vta-logo { width: 68px; height: 32px; }

  .vta-gc { min-width: 0; display: grid; align-items: stretch; }
  .vta-gc.has-gc,
  .vta-gc.pre-race { grid-template-columns: 1fr; }

  .vta-gc-item {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: 8px;
    align-items: center;
    color: #fff;
  }

  .gc-pos { color: var(--red); line-height: 1; font-weight: 1000; }

  .gc-name {
    min-width: 0;
    line-height: 1;
    font-weight: 1000;
    letter-spacing: -.3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gc-sub {
    color: #cfcfcf;
    line-height: 1;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gc-time {
    color: var(--red);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    line-height: 1;
    font-weight: 1000;
    white-space: nowrap;
  }

  .vta-hero {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-bottom: 3px solid var(--ink);
    background: #ddd;
  }

  .vta-hero img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .vta-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(17, 17, 17, .18) .65px, transparent .65px);
    background-size: 5px 5px;
    pointer-events: none;
  }

  .vta-hero-title {
    position: absolute;
    left: 16px;
    bottom: 14px;
    z-index: 2;
    color: var(--red);
    line-height: .86;
    font-weight: 1000;
    font-style: italic;
    letter-spacing: -1px;
    text-transform: uppercase;
    text-shadow: 2px 2px 0 #111;
    max-width: 90%;
    white-space: nowrap;
    overflow: hidden;
  }

  .vta-stage-block {
    min-width: 0;
    border-bottom: 3px solid var(--ink);
    background: #fbfaf5;
    display: grid;
    align-content: center;
  }

  .vta-date-line {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: 7px;
  }

  .vta-badge {
    background: var(--ink);
    color: #fff;
    line-height: 1;
    font-weight: 1000;
    letter-spacing: .5px;
    white-space: nowrap;
  }

  .vta-date {
    border-bottom: 2px solid var(--ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    line-height: 1;
    font-weight: 1000;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .vta-stage-title {
    line-height: .84;
    font-weight: 1000;
    letter-spacing: -.4px;
    white-space: nowrap;
  }

  .vta-route {
    min-width: 0;
    line-height: 1.02;
    font-weight: 1000;
    letter-spacing: -.6px;
    text-transform: uppercase;
    overflow: hidden;
  }

  .vta-route .arrow,
  .next-route .arrow { color: var(--red); }

  .vta-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    background: #fbfaf5;
    border-bottom: 3px solid var(--ink);
  }

  .vta-stat {
    min-width: 0;
    overflow: hidden;
    border-right: 2px solid var(--ink);
  }

  .vta-stat:last-child { border-right: 0; }

  .vta-stat-label {
    color: var(--muted);
    line-height: 1;
    font-weight: 1000;
    letter-spacing: .5px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .vta-stat-value {
    line-height: .9;
    font-weight: 1000;
    letter-spacing: -.5px;
    white-space: nowrap;
  }

  .vta-stat-unit {
    color: var(--muted);
    line-height: 1;
    font-weight: 1000;
  }

  .vta-bottom {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    background: #fbfaf5;
  }

  .next-number {
    background: var(--red);
    color: #fff;
    border-right: 3px solid var(--ink);
    font-weight: 1000;
  }

  .next-number .small { line-height: 1; letter-spacing: .5px; }
  .next-number .num { line-height: .88; }

  .next-main {
    min-width: 0;
    display: grid;
    grid-template-rows: auto auto;
    align-content: center;
    overflow: hidden;
    gap: 7px;
  }

  .next-date {
    display: inline-block;
    background: var(--ink);
    color: #fff;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    line-height: 1;
    font-weight: 1000;
  }

  .next-route {
    line-height: 1;
    font-weight: 1000;
    letter-spacing: -.4px;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .next-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 7px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 1000;
  }

  .next-type { background: var(--ink); color: #fff; }
</style>

<div class="layout vta-portrait p--2">
  <div class="vta-card rounded--large">
    <div class="vta-header">
      <div class="vta-logo-wrap flex flex--row flex--center-x flex--center-y px--2 py--2">
        <img class="vta-logo image image--contain" src="{{ vueltaLogo | default: 'https://www.lavuelta.es/img/global/logo-reversed@2x.png' }}" alt="La Vuelta a España">
      </div>

      <div class="vta-gc {% if gc and gc.size >= 3 %}has-gc{% else %}pre-race{% endif %}">
        {% if gc and gc.size >= 3 %}
          <div class="vta-gc-item px--2 py--1">
            <div class="gc-pos text--large">1</div>
            <div>
              <div class="gc-name text--base">{{ gc[0].name | upcase }}</div>
              <div class="gc-sub text--small mt--xsmall">{% if gc[0].team %}{{ gc[0].team | upcase }}{% else %}TOTAL TIME{% endif %}</div>
            </div>
            <div class="gc-time text--base">{{ gc[0].time }}</div>
          </div>
        {% else %}
          <div class="vta-gc-item px--2 py--1">
            <div class="gc-pos text--large">▶</div>
            <div>
              <div class="gc-name text--base">{{ preRaceHeader.title | default: "VUELTA STARTS" }}</div>
              <div class="gc-sub text--small mt--xsmall">GRAN SALIDA · {{ preRaceHeader.location | default: "SPAIN" }}</div>
            </div>
            <div class="gc-time text--base">{{ preRaceHeader.date | default: "AUGUST" }}</div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="vta-hero">
      {% if hero_image %}
        <img class="image image--cover image-dither" src="{{ hero_image }}" alt="{{ from }}">
      {% endif %}
      <div class="vta-hero-title text--xxlarge">{{ from | upcase }}</div>
    </div>

    <div class="vta-stage-block px--3 py--2">
      <div class="vta-date-line mb--small">
        <div class="vta-badge rounded--xsmall px--2 py--1 text--small">{{ stage_today.date | date: "%a" | upcase }}</div>
        <div class="vta-date pb--xsmall text--small">{{ stage_today.date | date: "%d %B %Y" | upcase }}</div>
      </div>

      <div class="vta-stage-title text--xxxlarge mb--small">STAGE {{ stage_today.stage }}</div>
      <div class="vta-route {{ route_class }}">
        {{ from | upcase }} <span class="arrow px--5">›</span> {{ to | upcase }}
      </div>
    </div>

    <div class="vta-stats">
      <div class="vta-stat px--2 py--2">
        <div class="vta-stat-label text--small">DISTANCE</div>
        <div class="vta-stat-value text--large">{{ stage_today.lengthDisplay | default: stage_today.length | default: stage_today.distance }}</div>
        <div class="vta-stat-unit text--small">KM</div>
      </div>

      <div class="vta-stat px--2 py--2">
        <div class="vta-stat-label text--small">{% if elevation_gain %}ELEVATION{% else %}TYPE{% endif %}</div>
        <div class="vta-stat-value text--base">{% if elevation_gain %}{{ elevation_gain }}{% else %}{{ type_label }}{% endif %}</div>
        <div class="vta-stat-unit text--small">{% if elevation_gain %}M{% else %}&nbsp;{% endif %}</div>
      </div>

      <div class="vta-stat px--2 py--2">
        <div class="vta-stat-label text--small">START</div>
        <div class="vta-stat-value text--large">{{ stage_today.startTime | slice: 0, 5 }}</div>
        <div class="vta-stat-unit text--small">CEST</div>
      </div>
    </div>

    {% if stage_tomorrow %}
      <div class="vta-bottom">
        <div class="next-number flex flex--col flex--center-x flex--center-y">
          <div class="small text--small">NEXT</div>
          <div class="num text--xlarge">{{ stage_tomorrow.stage }}</div>
        </div>

        <div class="next-main px--2 py--2">
          <div>
            <div class="next-date rounded--xsmall px--2 py--1 mb--xsmall text--small">{{ stage_tomorrow.date | date: "%a %d %B %Y" | upcase }}</div>
            <div class="next-route {{ next_route_class }}">
              {{ next_from | upcase }} <span class="arrow px--4">›</span> {{ next_to | upcase }}
            </div>
          </div>
          <div class="next-meta text--small">
            <span>{{ stage_tomorrow.lengthDisplay | default: stage_tomorrow.length }} KM</span>
            <span>|</span>
            <span class="next-type rounded--xsmall px--2 py--1">{{ next_type_label }}</span>
            <span>|</span>
            <span>{{ stage_tomorrow.startTime | slice: 0, 5 }} CEST</span>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>
