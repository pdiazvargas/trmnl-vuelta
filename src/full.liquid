{%- assign stages = stages | default: data.stages | default: data -%}
{%- assign stage_today = today | default: data.today -%}
{%- assign stage_tomorrow = tomorrow | default: data.tomorrow -%}
{%- if stage_today == blank and stages -%}
  {%- assign stage_today = stages[0] -%}
{% endif %}
{%- if stage_tomorrow == blank and stages -%}
  {%- assign stage_tomorrow = stages[1] -%}
{% endif %}
{%- assign from = stage_today.departureCity.label | default: stage_today.from -%}
{%- assign to = stage_today.arrivalCity.label | default: stage_today.to -%}
{%- assign next_from = stage_tomorrow.departureCity.label | default: stage_tomorrow.from -%}
{%- assign next_to = stage_tomorrow.arrivalCity.label | default: stage_tomorrow.to -%}
{%- assign route_len = from.size | plus: to.size -%}
{%- assign next_route_len = next_from.size | plus: next_to.size -%}
{%- assign hero_image = stage_today.arrivalCity.content.image | default: stage_today.toImage | default: stage_today.departureCity.content.image | default: stage_today.fromImage -%}
{%- assign elevation_gain = stage_today.elevationGain | default: stage_today.elevation_gain | default: stage_today.positiveElevation -%}
{%- case stage_today.type -%}
  {%- when 'EQU' -%}{%- assign type_label = 'TEAM TIME TRIAL' -%}
  {%- when 'PAS' -%}{%- assign type_label = 'TIME TRIAL' -%}
  {%- when 'PLN' -%}{%- assign type_label = 'FLAT' -%}
  {%- when 'MMG' -%}{%- assign type_label = 'MED. MOUNTAIN' -%}
  {%- when 'HMG' -%}{%- assign type_label = 'MOUNTAIN' -%}
  {%- when 'VAA' -%}{%- assign type_label = 'HILLY' -%}
  {%- when 'PAA' -%}{%- assign type_label = 'HILLY' -%}
  {%- when 'VAL' -%}{%- assign type_label = 'HILLY' -%}
  {%- else -%}{%- assign type_label = stage_today.type | default: 'STAGE' -%}
{% endcase %}
<style>
  .vta-layout,
  .vta-layout * { box-sizing: border-box; }

  .vta-layout {
    --red: #e2001a;
    --paper: #f4f1e8;
    --ink: #111;
    --muted: #777;
    padding: 8px;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
    font-family: Inter, Arial, Helvetica, sans-serif;
  }

  .vta-card {
    width: 100%;
    height: 100%;
    border: 3px solid var(--ink);
    border-radius: 14px;
    background: #fbfaf5;
    overflow: hidden;
    display: grid;
    grid-template-rows: 58px minmax(0, 1fr) 78px;
  }

  /* ── HEADER ── */
  .vta-header {
    background: var(--ink);
    color: #fff;
    display: grid;
    grid-template-columns: 116px 1fr;
    align-items: stretch;
    min-width: 0;
  }

  .vta-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 2px solid #fff;
    padding: 6px 8px;
  }

  .vta-logo {
    width: 92px;
    height: 40px;
    object-fit: contain;
    display: block;
  }

  .vta-gc {
    min-width: 0;
    display: grid;
    align-items: stretch;
  }

  .vta-gc.has-gc { grid-template-columns: 1fr 1fr 1fr; }
  .vta-gc.pre-race { grid-template-columns: 1fr 1fr; }

  .vta-gc-item {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: 6px;
    align-items: center;
    padding: 7px 10px;
    border-right: 1px solid #fff;
    color: #fff;
  }

  .vta-gc-item:last-child { border-right: 0; }

  .gc-pos {
    color: var(--red);
    font-size: 24px;
    line-height: 1;
    font-weight: 1000;
  }

  .gc-name {
    min-width: 0;
    font-size: 16px;
    line-height: 1;
    font-weight: 1000;
    letter-spacing: -.4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gc-sub {
    margin-top: 4px;
    color: #cfcfcf;
    font-size: 8px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: .4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gc-time {
    color: var(--red);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 14px;
    line-height: 1;
    font-weight: 1000;
    white-space: nowrap;
  }

  /* ── MAIN: hero city image with route overlay ── */
  .vta-main {
    position: relative;
    min-height: 0;
    min-width: 0;
    background: #ddd;
    overflow: hidden;
  }

  .vta-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.25);
    display: block;
  }

  .vta-main::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(#111 0.65px, transparent 0.65px);
    background-size: 5px 5px;
    opacity: .16;
    pointer-events: none;
  }

  .vta-main-caption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    z-index: 2;
    color: var(--red);
    font-size: 30px;
    line-height: .88;
    font-weight: 1000;
    font-style: italic;
    letter-spacing: -1.1px;
    text-transform: uppercase;
    text-shadow: 2px 2px 0 #111;
    max-width: 92%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
  }

  /* ── BOTTOM BAR: today's stage info ── */
  .vta-bottom {
    border-top: 3px solid var(--ink);
    display: grid;
    grid-template-columns: 78px minmax(0, 1fr) auto auto auto;
    min-width: 0;
    background: #fbfaf5;
  }

  .stage-number {
    background: var(--red);
    color: #fff;
    border-right: 3px solid var(--ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-weight: 1000;
    flex-shrink: 0;
  }

  .stage-number .small { font-size: 9px; letter-spacing: .7px; }
  .stage-number .num { font-size: 31px; line-height: .9; }

  .stage-route-col {
    min-width: 0;
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 3px solid var(--ink);
  }

  .stage-date {
    display: inline-block;
    background: var(--ink);
    color: #fff;
    border-radius: 3px;
    padding: 3px 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 8px;
    line-height: 1;
    font-weight: 1000;
    margin-bottom: 5px;
    align-self: flex-start;
  }

  .stage-route {
    font-size: 15px;
    line-height: 1;
    font-weight: 1000;
    letter-spacing: -.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
  }

  .stage-route.is-long { font-size: 13px; letter-spacing: -.35px; }
  .stage-route.is-very-long { font-size: 11.5px; letter-spacing: -.25px; }
  .stage-route .arrow { color: var(--red); padding: 0 4px; }

  .stage-stat {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border-right: 3px solid var(--ink);
    text-align: center;
  }

  .stage-stat:last-child { border-right: 0; }

  .stage-stat-label {
    font-size: 7px;
    line-height: 1;
    font-weight: 1000;
    letter-spacing: .7px;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .stage-stat-value {
    font-size: 18px;
    line-height: .95;
    font-weight: 1000;
    letter-spacing: -.8px;
    white-space: nowrap;
  }

  .stage-stat-value.is-type { font-size: 13px; letter-spacing: -.4px; }

  .stage-stat-unit {
    margin-top: 3px;
    color: var(--muted);
    font-size: 7px;
    line-height: 1;
    font-weight: 1000;
    letter-spacing: .5px;
  }

  /* ── LARGE (V2/X) ── */
  @media (min-width: 1000px) {
    .vta-layout { padding: 10px; }

    .vta-card {
      border-width: 4px;
      border-radius: 18px;
      grid-template-rows: 78px minmax(0, 1fr) 96px;
    }

    .vta-header { grid-template-columns: 150px 1fr; }
    .vta-logo-wrap { padding: 8px 12px; }
    .vta-logo { width: 120px; height: 52px; }

    .vta-gc-item { column-gap: 10px; padding: 9px 16px; }
    .vta-gc.pre-race .vta-gc-item { padding-left: 22px; padding-right: 22px; }
    .gc-pos { font-size: 34px; }
    .gc-name { font-size: 22px; }
    .gc-sub { margin-top: 7px; font-size: 11px; }
    .gc-time { font-size: 20px; }
    .vta-gc.pre-race .gc-name { font-size: 28px; }
    .vta-gc.pre-race .gc-sub { font-size: 12px; }
    .vta-gc.pre-race .gc-time { font-size: 25px; }
    .vta-gc.pre-race .gc-pos { font-size: 38px; }

    .vta-main-caption { font-size: 44px; left: 20px; bottom: 18px; }

    .vta-bottom {
      border-top-width: 4px;
      grid-template-columns: 112px minmax(0, 1fr) auto auto auto;
    }

    .stage-number { border-right-width: 4px; }
    .stage-number .small { font-size: 13px; }
    .stage-number .num { font-size: 46px; }

    .stage-route-col { padding: 12px 18px; border-right-width: 4px; }
    .stage-date { padding: 5px 8px; font-size: 12px; margin-bottom: 8px; }
    .stage-route { font-size: 25px; }
    .stage-route.is-long { font-size: 22px; }
    .stage-route.is-very-long { font-size: 19px; }

    .stage-stat { padding: 12px 20px; border-right-width: 4px; }
    .stage-stat-label { font-size: 11px; margin-bottom: 7px; }
    .stage-stat-value { font-size: 32px; letter-spacing: -1.4px; }
    .stage-stat-value.is-type { font-size: 22px; letter-spacing: -.8px; }
    .stage-stat-unit { margin-top: 6px; font-size: 11px; }
  }
</style>

<div class="layout vta-layout">
  <div class="vta-card">

    <!-- HEADER -->
    <div class="vta-header">
      <div class="vta-logo-wrap flex flex--center">
        <img class="vta-logo" src="{{ vueltaLogo | default: 'https://www.lavuelta.es/img/global/logo-reversed@2x.png' }}" alt="La Vuelta a España">
      </div>
      <div class="vta-gc {% if gc and gc.size >= 3 %}has-gc{% else %}pre-race{% endif %}">
        {% if gc and gc.size >= 3 %}
          <div class="vta-gc-item">
            <div class="gc-pos">1</div>
            <div>
              <div class="gc-name">{{ gc[0].name | upcase }}</div>
              <div class="gc-sub">{% if gc[0].team %}{{ gc[0].team | upcase }}{% else %}TOTAL TIME{% endif %}</div>
            </div>
            <div class="gc-time">{{ gc[0].time }}</div>
          </div>
          <div class="vta-gc-item">
            <div class="gc-pos">2</div>
            <div>
              <div class="gc-name">{{ gc[1].name | upcase }}</div>
              <div class="gc-sub">{% if gc[1].team %}{{ gc[1].team | upcase }}{% else %}BEHIND{% endif %}</div>
            </div>
            <div class="gc-time">{{ gc[1].gap }}</div>
          </div>
          <div class="vta-gc-item">
            <div class="gc-pos">3</div>
            <div>
              <div class="gc-name">{{ gc[2].name | upcase }}</div>
              <div class="gc-sub">{% if gc[2].team %}{{ gc[2].team | upcase }}{% else %}BEHIND{% endif %}</div>
            </div>
            <div class="gc-time">{{ gc[2].gap }}</div>
          </div>
        {% else %}
          <div class="vta-gc-item">
            <div class="gc-pos">&#9654;</div>
            <div>
              <div class="gc-name">{{ preRaceHeader.title | default: "VUELTA STARTS" }}</div>
              <div class="gc-sub">GRAN SALIDA · {{ preRaceHeader.location | default: "SPAIN" }}</div>
            </div>
            <div class="gc-time">{{ preRaceHeader.date | default: "AUGUST" }}</div>
          </div>
          <div class="vta-gc-item">
            <div class="gc-pos">{{ preRaceHeader.stageNumber | default: "1" }}</div>
            <div>
              <div class="gc-name">{{ preRaceHeader.stage | default: "STAGE 1 OF 21" }}</div>
              <div class="gc-sub">GENERAL CLASSIFICATION STARTS AFTER STAGE 1</div>
            </div>
            <div class="gc-time">{{ preRaceHeader.year | default: "2026" }}</div>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- MAIN: hero city image with route caption -->
    <div class="vta-main">
      {% if hero_image %}
        <img src="{{ hero_image }}" alt="Stage {{ stage_today.stage }}: {{ from }} to {{ to }}">
      {% endif %}
      <div class="vta-main-caption">{{ to | upcase }}</div>
    </div>

    <!-- BOTTOM BAR: today's stage info -->
    <div class="vta-bottom">
      <div class="stage-number">
        <div class="small">STAGE</div>
        <div class="num">{{ stage_today.stage }}</div>
        <div class="small">OF 21</div>
      </div>
      <div class="stage-route-col">
        <div class="stage-date">{{ stage_today.date | date: "%a %d %B %Y" | upcase }}</div>
        <div class="stage-route {% if route_len > 34 %}is-very-long{% elsif route_len > 24 %}is-long{% endif %}">
          {{ from | upcase }}<span class="arrow">›</span>{{ to | upcase }}
        </div>
      </div>
      <div class="stage-stat">
        <div class="stage-stat-label">DISTANCE</div>
        <div class="stage-stat-value">{{ stage_today.lengthDisplay | default: stage_today.length | default: stage_today.distance }}</div>
        <div class="stage-stat-unit">KM</div>
      </div>
      <div class="stage-stat">
        <div class="stage-stat-label">{% if elevation_gain %}ELEVATION{% else %}TYPE{% endif %}</div>
        <div class="stage-stat-value {% unless elevation_gain %}is-type{% endunless %}">{% if elevation_gain %}{{ elevation_gain }}{% else %}{{ type_label }}{% endif %}</div>
        <div class="stage-stat-unit">{% if elevation_gain %}M{% endif %}</div>
      </div>
      <div class="stage-stat">
        <div class="stage-stat-label">START</div>
        <div class="stage-stat-value">{{ stage_today.startTime | slice: 0, 5 }}</div>
        <div class="stage-stat-unit">CEST</div>
      </div>
    </div>

  </div>
</div>
