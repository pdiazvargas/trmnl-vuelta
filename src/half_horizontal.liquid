<div class="layout layout--col gap--small">

  <!-- STATUS PILL: race leader, or pre-race countdown before GC exists -->
  <div class="flex flex--row flex--right w--full">
    {% if has_gc %}
      <span class="label label--small label--filled rounded--full px--2 py--1" data-clamp="1">{{ gc_leader.name | upcase }} · {{ gc_leader.time }}</span>
    {% else %}
      <span class="label label--small label--filled rounded--full px--2 py--1" data-clamp="1">{{ preRaceHeader.title | default: "GRAN SALIDA" | upcase }} · {{ preRaceHeader.daysToGo | default: "-" }} DAYS</span>
    {% endif %}
  </div>

  <!-- Single horizontal strip: stage identity, stats, compact chart, next stage -->
  <div class="grid grid--cols-12 gap--small">
    <div class="col--span-1 flex flex--col flex--center-y">
      <span class="value value--xxlarge value--tnums" data-fit-value="true">{{ stage_today.stage }}</span>
    </div>

    <div class="col--span-3 flex flex--col flex--center-y gap--small">
      <span class="title title--base" data-clamp="1">{{ from | upcase }} › {{ to | upcase }}</span>
      <span class="label label--gray label--small">{{ type_label }} · {{ stage_today.date | date: "%a %d %b" | upcase }}</span>
    </div>

    <div class="col--span-2 flex flex--col flex--center-y gap--xsmall">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small value--tnums" data-fit-value="true">{{ stage_today.distanceValue | default: stage_today.lengthDisplay | default: stage_today.length | default: stage_today.distance }} {{ stage_today.distanceUnitLabel | default: "KM" }}</span>
          <span class="label label--small">DISTANCE</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small value--tnums" data-fit-value="true">{{ stage_today.startTimeDisplay | default: stage_today.startTime | slice: 0, 5 }} {{ stage_today.startTimeZoneLabel | default: "CEST" }}</span>
          <span class="label label--small">START</span>
        </div>
      </div>
    </div>

    <div class="col--span-4 flex flex--col flex--center-y flex--center-x">
      {% if elevationProfile %}
        {%- assign axis_y = elevationProfile.height -%}
        <svg viewBox="0 0 {{ elevationProfile.width }} {{ elevationProfile.height }}" preserveAspectRatio="none" class="vta-elevation-svg-hh w--full h--[100px]">
          <polygon points="0,{{ elevationProfile.height }} {{ elevationProfile.points }} {{ elevationProfile.width }},{{ elevationProfile.height }}" fill="#000"></polygon>
          <line x1="0" y1="{{ axis_y }}" x2="{{ elevationProfile.width }}" y2="{{ axis_y }}" stroke="#000" stroke-width="1.5"></line>
          {% for m in elevationProfile.markers %}
            {% case m.type %}
              {% when 'summit' %}
                <circle cx="{{ m.x }}" cy="{{ m.y | minus: 9 }}" r="6" fill="#e2001a" stroke="#fff" stroke-width="1"></circle>
              {% when 'sprint' %}
                <circle cx="{{ m.x }}" cy="{{ m.y | minus: 9 }}" r="5" fill="#e2001a" stroke="#fff" stroke-width="1"></circle>
            {% endcase %}
          {% endfor %}
        </svg>
      {% else %}
        <span class="label label--gray label--small">Elevation profile pending</span>
      {% endif %}
    </div>

    <div class="col--span-2 flex flex--col flex--center-y gap--xsmall">
      {% if stage_tomorrow %}
        <span class="label label--filled label--small" data-clamp="1">NEXT {{ stage_tomorrow.stage }}</span>
        <span class="label label--gray label--small" data-clamp="1">{{ next_from | upcase }} › {{ next_to | upcase }}</span>
      {% endif %}
    </div>
  </div>

</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ title_bar_icon }}">
  <span class="title">Vuelta a España</span>
  <span class="instance">Stage {{ stage_today.stage }}</span>
</div>
